# ─── Backend API ─────────────────────────────────────────────────────────────
# Base URL of the CloudVPS backend (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3000

# ─── NextAuth v5 ─────────────────────────────────────────────────────────────
# Random secret (min 32 chars): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=your_auth_secret_here
AUTH_URL=http://localhost:3001

# ─── Payment ──────────────────────────────────────────────────────────────────
# PromptPay number and bank account are now admin-configurable via system_configs
# (payment.promptpay_id, payment.bank_code, payment.bank_account_no, payment.bank_account_name)
# and served through GET /api/system-configs/payment-info — no frontend env var needed.
