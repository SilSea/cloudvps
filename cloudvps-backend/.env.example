# ─── Application ─────────────────────────────────────────────────────────────
PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────────────────────
# Frontend URL ที่อนุญาตให้เรียก API (ใส่หลาย URL คั่นด้วย comma)
CORS_ORIGIN=http://localhost:8080

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<dbname>"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cloudvps

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# ─── JWT ─────────────────────────────────────────────────────────────────────
# ใช้ random string ที่ยาวและซับซ้อน (min 32 chars)
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# PORT 465 = implicit TLS, PORT 587 = STARTTLS
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# ─── Proxmox ─────────────────────────────────────────────────────────────────
PROXMOX_HOST=https://<proxmox-ip>:<port>
PROXMOX_TOKEN_ID=root@pam!<token-name>
PROXMOX_TOKEN_SECRET=<uuid-token-secret>
PROXMOX_NODE=pve

# ─── Provisioning Defaults ───────────────────────────────────────────────────
PROXMOX_STORAGE=local-zfs
PROXMOX_BRIDGE_PUBLIC=vmbr0
PROXMOX_BRIDGE_PRIVATE=vmbr1
PROXMOX_GATEWAY_PUBLIC=10.0.0.1
PROXMOX_GATEWAY_PRIVATE=192.168.1.1
PROXMOX_SUBNET=24

# ─── SlipOK (Slip Verification) ──────────────────────────────────────────────
SLIPOK_API_KEY=your_slipok_api_key
SLIPOK_BRANCH_ID=your_branch_id

# ─── TrueMoney ───────────────────────────────────────────────────────────────
TRUEMONEY_API_URL=https://gift.truemoney.com/campaign/vouchers
TRUEMONEY_MOBILE=your_mobile_number

# ─── File Uploads ────────────────────────────────────────────────────────────
# Base directory for uploaded files (relative to project root)
UPLOAD_DIR=uploads
# Max size per file in MB (default 5)
MAX_ATTACHMENT_SIZE_MB=5
# Max image attachments per ticket message (default 3)
MAX_ATTACHMENTS_PER_MESSAGE=3

# ─── Testing ────────────────────────────────────────────────────────────────
# ตั้งเป็น 1 เพื่อ bypass rate limiting ระหว่าง integration tests
# ห้ามตั้งใน production
# RATE_LIMIT_DISABLED=1

# ─── Production Seed (ใช้เฉพาะตอน bun run db:seed:prod) ─────────────────────
# ไม่ต้องใส่ลง .env ปกติ — ส่งผ่าน env var ตอนรันแทน
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=SecurePassword123!
#
# ตัวอย่างการใช้งาน:
#   Bash:       ADMIN_EMAIL=admin@example.com ADMIN_PASSWORD=SecurePass123! bun run db:seed:prod
#   PowerShell: $env:ADMIN_EMAIL="admin@example.com"; $env:ADMIN_PASSWORD="SecurePass123!"; bun run db:seed:prod
